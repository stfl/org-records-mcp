            org-records-mcp-test--content-bare-todo)))))))

(ert-deftest org-records-mcp-test-object-text-said-in-the-tool-description ()
  "A tool taking an object parameter says the text form is taken."
  (org-records-mcp-test--with-enabled
    (dolist (tool
             '("org-node-set-properties" "org-node-create" "org-node-set-todo"))
