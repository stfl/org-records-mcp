(ert-deftest org-records-mcp-test-update-todo-state-with-note ()
  "Test TODO state update with an attached note."
  (let ((test-content "* TODO Task One\nTask description."))
    (org-records-mcp-test--with-temp-org-files
        ((test-file test-content))
      (let ((org-todo-keywords '((sequence "TODO" "|" "DONE")))
            (org-log-into-drawer t))
        (let ((link
               (org-records-mcp-test--file-link test-file "*Task One")))
          (let* ((params `((link . ,link)
                           (before . "TODO")
                           (after . "DONE")
                           (note . "Test note")))
                 (result-text (mcp-server-lib-ert-call-tool
                               "org-node-set-todo" params))
                 (result (json-read-from-string result-text)))
            (should (equal (alist-get 'success result) t))
            (should (equal (alist-get 'before result) "TODO"))
            (should (equal (alist-get 'after result) "DONE"))
            (org-records-mcp-test--verify-file-matches
             test-file
             org-records-mcp-test--expected-task-one-done-with-note-regex)))))))

