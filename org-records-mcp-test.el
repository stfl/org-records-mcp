(ert-deftest org-records-mcp-test-set-todo-repeat-reports-a-restarted-date ()
  "A `.+' repeater restarts from today, and that is reported.
The date the file ends up with is today plus the interval, which no
part of the call named."
  (org-records-mcp-test--with-temp-org-files
      ((test-file org-records-mcp-test--content-task-scheduled-restart))
    (let ((org-log-repeat nil)
          (org-todo-keywords '((sequence "TODO" "|" "DONE"))))
      (let* ((link (org-records-mcp-test--file-link test-file "*Weekly Task"))
             (result
              (org-records-mcp-test--finish-repeating
               link 'scheduled "<2026-01-01 Thu .+2d>"))
             (move (org-records-mcp-test--planning-move result 'scheduled)))
        (should (equal (alist-get 'after result) "TODO"))
        (should (equal (car move) "<2026-01-01 Thu .+2d>"))
        (should
