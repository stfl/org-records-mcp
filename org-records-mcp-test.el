               (start_time . "2026-01-01T11:00:00")
               (clock_out
                . ,(org-records-mcp-test--file-link running-file "*Task One")))))))
        (should (string= (org-records-mcp-test--read-file test-file)
                         org-records-mcp-test--content-file-drawer))
        (org-records-mcp-test--verify-no-modified-buffer running-file)
        (should (eq (org-clock-is-active) (find-buffer-visiting running-file)))
        (should (= (marker-position org-clock-marker) position))))))

