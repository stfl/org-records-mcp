(defconst org-records-mcp-test--clearing-writes
  `(("org-node-set-todo"
     . ,(lambda (value)
          (org-records-mcp-test--advertised-clearing-accepted
           "org-node-set-todo" "* TODO Task\nBody.\n" "*Task"
