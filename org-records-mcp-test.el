                  (list "org-clock-delete" `((link . ,link)
                                             (start . ,sent)))))
          (org-records-mcp-test--call-tool-refused
           (car call) (cadr call)
           (concat "\\`Not a time: '" (regexp-quote sent) "'\\.")
           test-file))))))

