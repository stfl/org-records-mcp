;; Test helpers

(defun org-records-mcp-test--read-file (file)
  "Read and return the contents of FILE as a string."
  (with-temp-buffer
    (insert-file-contents file)
    (buffer-string)))

(defun org-records-mcp-test--verify-file-matches (test-file expected-pattern)
  "Verify TEST-FILE content matches EXPECTED-PATTERN regexp."
  (should (string-match-p expected-pattern (org-records-mcp-test--read-file test-file))))

(defun org-records-mcp-test--verify-buffer-matches (buffer expected-pattern)
  "Verify the complete contents of BUFFER match EXPECTED-PATTERN regexp."
  (with-current-buffer buffer
    (save-restriction
      (widen)
      (should (string-match-p expected-pattern (buffer-string))))))

(defun org-records-mcp-test--file-link (file search)
  "Return the `file:' link to FILE with SEARCH after `::'.
The file name is written the way `org-store-link' writes it.  SEARCH
is `*Title', `#custom-id' or a line of text."
  (concat "file:" (abbreviate-file-name file) "::" search))

(defun org-records-mcp-test--should-resolve-to (link title)
  "Assert that a later tool call reaches the heading TITLE through LINK.
LINK must be an `id:' or `file:' link.  org-node-read must read a heading
titled TITLE there and return LINK itself as that heading's link."
  (should (string-match-p "\\`\\(?:id\\|file\\):" link))
  (let ((heading (json-read-from-string (org-records-mcp-test--call-read link))))
    (should (equal (alist-get 'title heading) title))
    (should (equal (alist-get 'link heading) link))))

(defmacro org-records-mcp-test--assert-error-and-file (test-file error-form)
  "Assert that ERROR-FORM throws an error and TEST-FILE remains unchanged."
  (declare (indent 1) (debug t))
  `(let ((original-content (org-records-mcp-test--read-file ,test-file)))
     (should-error ,error-form :type 'mcp-server-lib-tool-error)
     (should (string= (org-records-mcp-test--read-file ,test-file) original-content))))

(defvar org-records-mcp-test--in-request nil
  "Non-nil while the MCP server handles a request.")

(defvar org-records-mcp-test--created-ids nil
  "Buffers in which Org's ID generator ran during an MCP request.")

(defun org-records-mcp-test--mark-request (orig &rest args)
  "Call ORIG with ARGS with `org-records-mcp-test--in-request' bound to t."
  (let ((org-records-mcp-test--in-request t))
    (apply orig args)))

(defun org-records-mcp-test--record-created-id (&rest _)
  "Record that Org's ID generator ran while org-records-mcp handled a request."
  (when org-records-mcp-test--in-request
    (push (buffer-name) org-records-mcp-test--created-ids)))

(defmacro org-records-mcp-test--with-enabled (&rest body)
  "Run BODY with org-records-mcp enabled, ensuring cleanup.
Fails the test when Org's ID generator runs while org-records-mcp handles
any request in BODY, since org-records-mcp creates no identifiers.  Every
path that makes an ID, `org-id-get-create' and `org-id-get' with
CREATE included, goes through `org-id-new', which is watched.  Test
setup outside requests may still create IDs."
  (declare (indent defun) (debug t))
  `(let ((org-records-mcp-test--created-ids nil)
         ;; An enclosing use of this macro already watches, and removes
         ;; the advice when it is done.
         (watching
          (advice-member-p #'org-records-mcp-test--record-created-id 'org-id-new)))
     (unless watching
       (advice-add 'mcp-server-lib-process-jsonrpc
                   :around #'org-records-mcp-test--mark-request)
       (advice-add 'org-id-new :before #'org-records-mcp-test--record-created-id))
     (org-records-mcp-enable)
     (unwind-protect
         ;; `org-records-mcp-enable' registers the server record itself, so the
         ;; helper leaves it alone and `initialize' reports org-records-mcp's own
         ;; serverInfo rather than the helper's test values.  The version
         ;; is spelled out rather than taken from `org-records-mcp-version', so
         ;; that this pins what a client receives instead of re-deriving
         ;; it from the same header the server reads.  A release bumps it
         ;; here too.
         (prog1 (mcp-server-lib-ert-with-server
                  :tools t
                  :resources t
                  :version "0.12.0"
                  ,@body)
           (should-not org-records-mcp-test--created-ids))
       (org-records-mcp-disable)
       (unless watching
         (advice-remove 'org-id-new #'org-records-mcp-test--record-created-id)
         (advice-remove 'mcp-server-lib-process-jsonrpc
                        #'org-records-mcp-test--mark-request)))))

(defmacro org-records-mcp-test--with-temp-org-files (file-specs &rest body)
  "Create temporary Org files, execute BODY, and ensure cleanup.
FILE-SPECS is a list of file specifications.
Each spec is (VAR CONTENT [FILENAME-PREFIX]).
VAR is the variable to bind the temp file path to.
CONTENT is the initial content to write to the file.
FILENAME-PREFIX is optional, defaults to \"org-records-mcp-test\".
All created files are automatically added to `org-records-mcp-allowed-files'.
BODY is executed with org-records-mcp enabled."
  (declare (indent 1))
  (let* ((vars (mapcar #'car file-specs))
         (temp-vars (mapcar (lambda (v) (gensym (symbol-name v)))
                            vars))
         (bindings (cl-mapcar
                    (lambda (var temp-var)
                      `(,var ,temp-var))
                    vars temp-vars))
         (inits (cl-mapcar
                 (lambda (temp-var spec)
                   (let ((content (nth 1 spec))
                         (filename (or (nth 2 spec) "org-records-mcp-test")))
                     `(setq ,temp-var
                            (make-temp-file ,filename nil ".org" ,content))))
                 temp-vars file-specs))
         (cleanups (mapcar
                    (lambda (temp-var)
                      `(when ,temp-var
                         ;; A buffer BODY left visiting the file, open
                         ;; or modified, is killed before the file
                         ;; goes: `make-temp-file' can hand a later
                         ;; test the same name back, and a buffer
                         ;; still around for it would serve that test
                         ;; stale content instead of what it wrote.
                         (when-let* ((buffer (find-buffer-visiting ,temp-var)))
                           (with-current-buffer buffer
                             (set-buffer-modified-p nil))
                           (kill-buffer buffer))
                         (delete-file ,temp-var)))
                    temp-vars)))
    `(let (,@temp-vars)
       (unwind-protect
           (progn
             ,@inits
             (let (,@bindings
                   (org-records-mcp-allowed-files (list ,@temp-vars)))
               (org-records-mcp-test--with-enabled
                 ,@body)))
         ,@cleanups))))

(defmacro org-records-mcp-test--with-id-tracking
    (allowed-files id-locations &rest body)
  "Set up org-id tracking with ID-LOCATIONS and run BODY.
ALLOWED-FILES is the list of files to bind to `org-records-mcp-allowed-files'.
ID-LOCATIONS is a list of (ID . FILE) cons cells to register.
Sets up `org-id-track-globally' and `org-id-locations-file',
then registers each ID location.  `org-id-locations' and
`org-id-files' are bound, so no registration outlives BODY."
  (declare (indent 2) (debug t))
  `(let ((org-id-track-globally t)
         (org-id-locations-file nil) ; Prevent saving to disk
         (org-id-locations nil)
         (org-id-files nil)
         (org-records-mcp-allowed-files ,allowed-files))
     (dolist (id-loc ,id-locations)
       (org-id-add-location (car id-loc) (cdr id-loc)))
     ,@body))

(defmacro org-records-mcp-test--with-id-setup (file-var initial-content ids &rest body)
  "Create temp file, set up org-id tracking with IDS, run BODY.
FILE-VAR is the variable to bind the temp file path to.
INITIAL-CONTENT is the initial content to write to the file.
IDS is a list of ID strings to register.
Sets up `org-id-track-globally' and `org-id-locations-file',
then registers each ID location and enables MCP for BODY.
The created temp file is automatically added to `org-records-mcp-allowed-files'."
  (declare (indent 2) (debug t))
  `(org-records-mcp-test--with-temp-org-files
       ((,file-var ,initial-content))
     (org-records-mcp-test--with-id-tracking
      (list ,file-var)
      (mapcar (lambda (id) (cons id ,file-var)) ,ids)
      ,@body)))

