(ert-deftest org-records-mcp-test-node-refile-refused-leaves-the-buffer-alone ()
  "A refused refile moves nothing, in either file or either buffer."
  (org-records-mcp-test--with-verbs-files test-file other-file
    (let ((stale (org-records-mcp-test--verbs-digest))
          (link (org-records-mcp-test--verbs-link)))
      (mcp-server-lib-ert-call-tool
       "org-node-set-title"
       `((link . ,link) (before . "Target") (after . "Target renamed")))
      (let ((other-before (org-records-mcp-test--read-file other-file)))
        (org-records-mcp-test--with-dirty-buffer (buffer on-disk) test-file
          (org-records-mcp-test--call-tool-refused
           "org-node-refile"
           `((link . ,link)
             (before . ,stale)
             (parent
              .
              ,(org-records-mcp-test--file-link other-file "*Project One")))
