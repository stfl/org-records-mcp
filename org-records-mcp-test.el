      (let ((org-log-note-clock-out t)
            (org-log-into-drawer t))
        (org-records-mcp-test--with-session-clock test-file
          (let ((link
                 (org-records-mcp-test--file-link test-file "*Task One")))
            (org-records-mcp-test--should-report-the-closed-hour
             (org-records-mcp-test--call-clock-out
              link "2026-01-01T11:00:00" blank)
             link))
          (org-records-mcp-test--should-leave-no-log-prompt)
          (org-records-mcp-test--verify-file-matches
           test-file org-records-mcp-test--clock-add-expected-regex))))))

(ert-deftest org-records-mcp-test-clock-out-note-arms-no-prompt ()
  "A `note' changes nothing about the prompt a clock-out must not arm.
Org reaches its clock-out entry by pushing `org-add-log-note' onto
the global `post-command-hook', which inside an MCP call would pop a
note prompt at the user's next unrelated command.  The note rides
that entry, so it is written here and the hook is left as it was
found, whether the call carried prose or not."
  (dolist (note (list nil org-records-mcp-test--clock-out-prose))
    (org-records-mcp-test--with-temp-org-files
        ((test-file org-records-mcp-test--clock-task-with-open-clock))
      (let ((org-log-note-clock-out t)
            (org-log-into-drawer t))
        (org-records-mcp-test--with-session-clock test-file
          (let ((link
                 (org-records-mcp-test--file-link test-file "*Task One")))
            (org-records-mcp-test--should-report-the-closed-hour
             (org-records-mcp-test--call-clock-out
              link "2026-01-01T11:00:00" note)
             link))
          (org-records-mcp-test--should-leave-no-log-prompt)
          (org-records-mcp-test--verify-file-matches
           test-file
           (if note
               org-records-mcp-test--clock-out-with-note-regex
             org-records-mcp-test--clock-add-expected-regex)))))))

