       (org-records-mcp-test--call-tag-tool
        "org-node-set-tags"
        `((link . ,link) (before . []) (after . "nonexistent")))
       [] ["nonexistent"] []))))

(ert-deftest org-records-mcp-test-set-tags-mutex-violation ()
