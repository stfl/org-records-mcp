                       (alist-get 'after result)))
      (org-records-mcp-test--verify-file-matches
       test-file org-records-mcp-test--pattern-scheduled-with-span))))

(ert-deftest org-records-mcp-test-set-scheduled-writes-a-backwards-span ()
  "A span ending at an earlier hour than it starts is written as sent.
Org reads it, writes it and reads it back unchanged, so nothing the
