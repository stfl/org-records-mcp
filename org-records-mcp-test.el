(ert-deftest org-records-mcp-test-returned-link-clock-tools ()
  "Clock tools link the clocked heading, wherever they leave point.
Adding, starting, finding, stopping and deleting a clock all return
Gamma's title link, although the edit ends on a CLOCK line."
  (org-records-mcp-test--with-temp-org-files
      ((test-file org-records-mcp-test--content-links))
    (let ((gamma (org-records-mcp-test--file-link test-file "*Gamma")))
      (should
       (equal
        (alist-get
         'link
         (org-records-mcp-test--call-clock-add
          gamma "2026-03-23T10:00:00" "2026-03-23T11:00:00"))
        gamma))
      (should
       (equal
        (alist-get
         'link (org-records-mcp-test--call-clock-in gamma "2026-03-23T14:30:00"))
        gamma))
      (should (equal (alist-get 'link (org-records-mcp-test--call-clock-get-active))
                     gamma))
      (should
       (equal
        (org-records-mcp-test--links-in (org-records-mcp-test--call-clock-find-dangling))
        (list gamma)))
      (should
       (equal
        (alist-get
         'link (org-records-mcp-test--call-clock-out gamma "2026-03-23T16:45:00"))
        gamma))
      (should
       (equal
        (alist-get
         'link (org-records-mcp-test--call-clock-delete gamma "2026-03-23T10:00:00"))
        gamma))
      (org-records-mcp-test--verify-file-matches
       test-file org-records-mcp-test--regex-links-gamma-clocked))))

(ert-deftest org-records-mcp-test-returned-link-query-in-narrowed-buffer ()
  "Queries read headings outside the user's narrowing where they are.
The user's buffer is narrowed to Alpha.  org-query and org-view both
return Gamma with its own title and link, and the narrowing is
unchanged afterwards."
  (org-records-mcp-test--with-configured-server
      ((test-file org-records-mcp-test--content-links))
      ((org-records-mcp-views '((todo :name "Todo" :query (todo))))
       (org-records-mcp-query-sort-fn nil))
    (let ((buffer (find-file-noselect test-file)))
      (unwind-protect
          (let ((restriction
                 (with-current-buffer buffer
                   (goto-char (point-min))
                   (re-search-forward "^\\* Alpha")
                   (org-narrow-to-subtree)
                   (list (point-min) (point-max)))))
            (dolist (call '(("org-query" (query . "(todo)"))
                            ("org-view" (view . "todo"))))
              (let ((matches
                     (alist-get
                      'children
                      (json-read-from-string
                       (mcp-server-lib-ert-call-tool
                        (car call) (cdr call))))))
                (should (= (length matches) 1))
                (should (equal (alist-get 'title (aref matches 0)) "Gamma"))
                (should
                 (equal (alist-get 'link (aref matches 0))
                        (org-records-mcp-test--file-link test-file "*Gamma")))))
            (should
             (equal (with-current-buffer buffer
                      (list (point-min) (point-max)))
                    restriction)))
        (kill-buffer buffer)))))

(ert-deftest org-records-mcp-test-returned-link-session-clock-in-narrowed-buffer ()
  "The session's clock is read where it is, outside the user's narrowing.
The Emacs clock runs in Clocked while the user's buffer is narrowed to
Alpha.  org-clock-active names Clocked and links it, and the
narrowing is unchanged afterwards."
  (org-records-mcp-test--with-temp-org-files
      ((test-file org-records-mcp-test--content-read-tools))
    (org-records-mcp-test--with-session-clock test-file
      (let* ((buffer (find-buffer-visiting test-file))
             (restriction
              (with-current-buffer buffer
                (goto-char (point-min))
                (re-search-forward "^\\* Alpha")
                (org-narrow-to-subtree)
                (list (point-min) (point-max))))
             (active (org-records-mcp-test--call-clock-get-active)))
        (should (equal (alist-get 'heading active) "Clocked"))
        (should
         (equal (alist-get 'link active)
                (org-records-mcp-test--file-link test-file "*Clocked")))
        (should
         (equal (with-current-buffer buffer
                  (list (point-min) (point-max)))
                restriction))))))

(ert-deftest org-records-mcp-test-read-tools-leave-files-unchanged ()
  "Every read tool and resource leaves the file byte-for-byte unchanged.
The reads cover each read tool, with and without a file set where it
takes one, and the org://{link} resource with links, encoded and raw.
Each read runs once with no buffer visiting the file and once with a
clean one.  Afterwards the file on disk is the before image, the
buffer is unmodified with its text untouched, and Org's ID locations
have not grown.  Every node in a result carries its link, the file's
own among them, and each link reads back to itself through
org-node-read."
  (org-records-mcp-test--with-configured-server
      ((test-file org-records-mcp-test--content-read-tools))
      ((org-records-mcp-views '((todo :name "Todo" :query (todo))))
       (org-records-mcp-query-sort-fn nil)
       (org-tag-alist nil)
       (org-tag-persistent-alist nil))
    (org-records-mcp-test--with-id-tracking
        (list test-file)
        `((,org-records-mcp-test--link-beta-id . ,test-file)
          (,org-records-mcp-test--link-both-id . ,test-file))
      (let* ((beta (concat "id:" org-records-mcp-test--link-beta-id))
             (reads
              (list
               (lambda () (org-records-mcp-test--call-read (format "file:%s" test-file)))
               (lambda ()
                 (org-records-mcp-test--call-read (format "[[file:%s][Links]]" test-file)))
               (lambda () (org-records-mcp-test--call-read beta))
               (lambda () (org-records-mcp-test--call-read (format "[[%s][Beta]]" beta)))
               (lambda () (org-records-mcp-test--call-read (org-records-mcp-test--file-link test-file "*Alpha")))
               (lambda ()
                 (org-records-mcp-test--call-read
                  (org-records-mcp-test--file-link test-file "#alpha-slug")))
               (lambda ()
                 (org-records-mcp-test--call-read-headline
                  (org-records-mcp-test--file-link test-file "*Gamma")))
               (lambda ()
                 (org-records-mcp-test--call-read-headline (format "file:%s" test-file)))
               (lambda ()
                 (mcp-server-lib-ert-call-tool
                  "org-query"
                  `((query . "(todo)") (files . ,(vector test-file)))))
               (lambda ()
                 (mcp-server-lib-ert-call-tool
                  "org-view" '((view . "todo"))))
               (lambda ()
                 (mcp-server-lib-ert-call-tool "org-config-tag-candidates" nil))
               (lambda ()
                 (mcp-server-lib-ert-call-tool
                  "org-config-tag-candidates" `((files . ,(vector test-file)))))
               (lambda ()
                 (mcp-server-lib-ert-call-tool "org-clock-active" nil))
               (lambda ()
                 (mcp-server-lib-ert-call-tool "org-clock-dangling" nil))
               (lambda ()
                 (mcp-server-lib-ert-call-tool
                  "org-clock-dangling" `((files . ,(vector test-file)))))
               (lambda ()
                 (org-records-mcp-test--read-resource
                  (car
                   (org-records-mcp-test--resource-uris (format "file:%s" test-file)))))
               (lambda ()
                 (org-records-mcp-test--read-resource
                  (car (org-records-mcp-test--resource-uris beta))))
               (lambda ()
                 (org-records-mcp-test--read-resource
                  (car
                   (org-records-mcp-test--resource-uris
                    (org-records-mcp-test--file-link test-file "#alpha-slug")))))
               (lambda ()
                 (org-records-mcp-test--read-resource
                  (car
                   (org-records-mcp-test--resource-uris
                    (org-records-mcp-test--file-link test-file "*Gamma")))))
               (lambda ()
                 (org-records-mcp-test--read-resource (concat "org://file:" test-file)))
               (lambda ()
                 (org-records-mcp-test--read-resource
                  (concat "org://" (org-records-mcp-test--file-link test-file "*Beta"))))
               (lambda ()
                 (org-records-mcp-test--read-resource (concat "org://" beta)))))
             (ids (hash-table-count org-id-locations))
             (links nil))
        (should-not (find-buffer-visiting test-file))
        (dolist (visited '(nil t))
          (dolist (read reads)
            (let ((buffer (find-buffer-visiting test-file)))
              (when (and buffer (not visited))
                (kill-buffer buffer))
              (when visited
                (setq buffer (find-file-noselect test-file)))
              (let ((ticks (and visited (buffer-chars-modified-tick buffer)))
                    (result (funcall read)))
                (when (string-prefix-p "{" result)
                  (setq links
                        (append
                         links
                         (org-records-mcp-test--links-in
                          (json-read-from-string result)))))
                (should
                 (string= (org-records-mcp-test--read-file test-file)
                          org-records-mcp-test--content-read-tools))
                (setq buffer (find-buffer-visiting test-file))
                (should-not (and buffer (buffer-modified-p buffer)))
                (when visited
                  (should
                   (= ticks (buffer-chars-modified-tick buffer))))))))
        (should (= ids (hash-table-count org-id-locations)))
        (should
         (equal
          (sort (delete-dups (copy-sequence links)) #'string<)
          (sort
           (list
            beta
            (concat "id:" org-records-mcp-test--link-both-id)
            (org-records-mcp-test--file-link test-file "#alpha-slug")
            (org-records-mcp-test--file-link test-file "*Review")
            (org-records-mcp-test--file-link test-file "*Gamma")
            (org-records-mcp-test--file-link test-file "*Blank ID")
            (org-records-mcp-test--file-link test-file "*Decorated")
            (org-records-mcp-test--file-link test-file "*Clocked")
            (concat "file:" (abbreviate-file-name test-file)))
           #'string<)))
        (dolist (link (delete-dups (copy-sequence links)))
          (should
           (equal
            (alist-get
             'link (json-read-from-string (org-records-mcp-test--call-read link)))
            link)))
        (should
         (string= (org-records-mcp-test--read-file test-file)
                  org-records-mcp-test--content-read-tools))
        (should-not (buffer-modified-p (find-buffer-visiting test-file)))))))

;;; Null and false are the parameter left out

(ert-deftest org-records-mcp-test-null-before-is-a-parameter-left-out ()
  "A blank `before' asserts nothing; it is the parameter left out.
Clients fill a parameter they are not using with a blank, so reading
null as \"the field held nothing\" would let such a client vouch for
an emptiness it never saw and go on to destroy what was there.  The
assertion of absence is the empty string, which a call has to type."
  (org-records-mcp-test--with-temp-org-files
      ((test-file org-records-mcp-test--content-todo-with-scheduled))
    (let ((link (org-records-mcp-test--file-link test-file "*Scheduled Task"))
          (missing "\\`Missing required parameter: before\\'"))
      (dolist (blank '(nil :json-false []))
        (org-records-mcp-test--call-tool-refused
         "org-node-set-todo"
         `((link . ,link) (before . ,blank) (after . "DONE"))
         missing test-file)
        (org-records-mcp-test--call-tool-refused
         "org-node-set-title"
         `((link . ,link) (before . ,blank) (after . "Renamed"))
         missing test-file)
        (org-records-mcp-test--call-tool-refused
         "org-node-set-scheduled"
         `((link . ,link) (before . ,blank) (after . "2026-04-15"))
         missing test-file)
        (org-records-mcp-test--call-tool-refused
         "org-node-set-scheduled"
         `((link . ,link) (before . ,blank) (after))
         missing test-file)
        (org-records-mcp-test--call-tool-refused
         "org-node-delete"
         `((link . ,link) (before . ,blank))
         missing test-file)))))

(ert-deftest org-records-mcp-test-null-before-left-out-on-deadline-and-priority ()
