  (concat
   "\\`"
   (regexp-quote
    (concat
     org-records-mcp-test--content-links-preamble
     org-records-mcp-test--content-links-alpha))
   "\\* [^\n]*Beta[^\n]*\n"
   "\\(?:.\\|\n\\)*"
   ":ID: +" org-records-mcp-test--link-beta-id "\n"
   "\\(?:.\\|\n\\)*"
   (regexp-quote org-records-mcp-test--content-links-gamma)
