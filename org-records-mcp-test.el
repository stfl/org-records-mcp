            (let ((result
                   (json-read-from-string
                    (mcp-server-lib-ert-call-tool
                     "org-node-set-properties"
                     `((link . ,link)
                       (before . ((SECOND)))
                       (after . ((SECOND . "2"))))))))
              (should (eq (alist-get 'saved result) t)))
            (org-records-mcp-test--verify-file-matches
             test-file org-records-mcp-test--pattern-set-first-and-second-property))
        (kill-buffer buffer)))))

(ert-deftest org-records-mcp-test-hook-save-reports-saved ()
  "Test `saved' is true when a hook saves the buffer during the call.
The buffer holds the user's unsaved edit, so org-records-mcp does not save it,
but a function on `org-property-changed-functions' does.  The change is
