    (let ((result
           (json-read-from-string
            (mcp-server-lib-ert-call-tool
             "org-node-create"
             `((title . "Task")
               (todo . "TODO")
               (parent . ,(concat "file:" test-file))
               (previous_sibling . []))))))
      (should (equal (alist-get 'success result) t))
      (should
       (equal (alist-get 'link result)
              (org-records-mcp-test--file-link test-file "*Task"))))
