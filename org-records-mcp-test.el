;;; Tests for org-node-set-priority

(ert-deftest org-records-mcp-test-set-priority-set ()
  "Test setting priority on a bare task."
  (org-records-mcp-test--with-temp-org-files
      ((test-file org-records-mcp-test--content-bare-todo))
    (let* ((link (org-records-mcp-test--file-link test-file "*Simple Task"))
           (params `((link . ,link)
                     (before . "")
                     (after . "A")))
           (result-text
            (mcp-server-lib-ert-call-tool "org-node-set-priority" params))
           (result (json-read-from-string result-text)))
      (should (equal (alist-get 'success result) t))
      (should (eq (alist-get 'saved result) t))
