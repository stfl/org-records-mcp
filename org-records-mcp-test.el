   (mcp-server-lib-ert-call-tool
    "org-node-set-properties"
    `((link . ,link)
      (before . ((SEEN)))
      (after . ((SEEN . "yes")))))))

(defun org-records-mcp-test--links-in (value)
  "Return every `link' string in VALUE, a parsed JSON result, in order."
  (cond
   ((vectorp value)
    (apply #'append (mapcar #'org-records-mcp-test--links-in value)))
   ((and (consp value) (consp (car value)))
    (apply #'append
           (mapcar
            (lambda (field)
              (if (and (eq (car field) 'link) (stringp (cdr field)))
                  (list (cdr field))
                (org-records-mcp-test--links-in (cdr field))))
            value)))
   (t
    nil)))

