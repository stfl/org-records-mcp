;;; A date parameter is a timestamp Org parses
;;
;; `after' is validated by Org's own parser, so what it accepts is the
;; Org timestamp vocabulary a read already speaks: the ISO shorthand,
;; a repeater, a warning period, and the raw string a read returns.
;; What Org's parser reads as another date than the one written is
;; refused before the link is resolved, so the file is untouched.

(defconst org-records-mcp-test--content-repeating-deadline
  "* TODO Repeating Deadline
DEADLINE: <2026-06-20 Sat ++1m -2d>
Task body."
  "TODO task whose DEADLINE carries a repeater and a warning period.")

(defconst org-records-mcp-test--pattern-scheduled-day-only
  (concat
   "\\`\\* TODO Simple Task\n"
   "SCHEDULED: <2026-03-27 [^ >]+>\n"
   "Task body text\\.\n?\\'")
  "Pattern after a SCHEDULED naming a day and no time of day.")

(defconst org-records-mcp-test--pattern-scheduled-with-repeater
  (concat
   "\\`\\* TODO Simple Task\n"
   "SCHEDULED: <2026-03-27 [^ >]+ \\+1w>\n"
   "Task body text\\.\n?\\'")
  "Pattern after a SCHEDULED carrying a repeater is written.")

(defconst org-records-mcp-test--pattern-scheduled-with-warning
  (concat
   "\\`\\* TODO Simple Task\n"
   "SCHEDULED: <2026-03-27 [^ >]+ -3d>\n"
   "Task body text\\.\n?\\'")
  "Pattern after a SCHEDULED carrying a warning period is written.")

(defconst org-records-mcp-test--pattern-scheduled-with-span
  (concat
   "\\`\\* TODO Simple Task\n"
   "SCHEDULED: <2026-03-27 [^ >]+ 09:00-10:00>\n"
   "Task body text\\.\n?\\'")
  "Pattern after a SCHEDULED carrying a span of the day.")

(defconst org-records-mcp-test--pattern-scheduled-with-backwards-span
  (concat
   "\\`\\* TODO Simple Task\n"
   "SCHEDULED: <2026-03-27 [^ >]+ 10:00-09:00>\n"
   "Task body text\\.\n?\\'")
  "Pattern after a SCHEDULED whose span ends at an earlier hour.")

(defconst org-records-mcp-test--pattern-scheduled-with-first-only-delay
  (concat
   "\\`\\* TODO Simple Task\n"
   "SCHEDULED: <2026-03-27 [^ >]+ --3d>\n"
   "Task body text\\.\n?\\'")
  "Pattern after a SCHEDULED carrying a first-only warning delay.")

(defconst org-records-mcp-test--pattern-deadline-with-repeater-and-warning
  (concat
   "\\`\\* TODO Simple Task\n"
   "DEADLINE: <2026-03-27 [^ >]+ 09:00 \\.\\+2d -1d>\n"
   "Task body text\\.\n?\\'")
  "Pattern after a DEADLINE carrying both a repeater and a warning.")

(defconst org-records-mcp-test--pattern-scheduled-round-tripped
  (concat
   "\\`\\* TODO Repeating Task\n"
   "SCHEDULED: <2026-06-20 [^ >]+ \\+1w -3d>\n"
   "Task body\\.\n?\\'")
  "Pattern after the string a read returned is sent back as `after'.
The heading carries the timestamp it carried before the call.")

(defconst org-records-mcp-test--pattern-repeating-deadline-moved
  (concat
   "\\`\\* TODO Repeating Deadline\n"
   "DEADLINE: <2026-07-20 [^ >]+ \\+\\+1m -2d>\n"
   "Task body\\.\n?\\'")
  "Pattern after a date-only change to a DEADLINE carrying a repeater.
The repeater and the warning period stand as they were.")

(defconst org-records-mcp-test--pattern-leap-day-deadline
  (concat
   "\\`\\* TODO Simple Task\n"
   "DEADLINE: <2028-02-29 [^ >]+>\n"
   "Task body text\\.\n?\\'")
  "Pattern after the leap day of a leap year is written.")

(defconst org-records-mcp-test--pattern-scheduled-past-2037
  (concat
   "\\`\\* TODO Simple Task\n"
   "SCHEDULED: <2050-06-15 [^ >]+>\n"
   "Task body text\\.\n?\\'")
  "Pattern after a date beyond the 32-bit era is written.")

(ert-deftest org-records-mcp-test-set-deadline-writes-a-real-leap-day ()
  "The leap day of a leap year is a date, and it is written.
The check asks Org whether the day exists, not whether February has
twenty-nine days in general."
  (org-records-mcp-test--with-temp-org-files
      ((test-file org-records-mcp-test--content-bare-todo))
    (let ((result
           (json-read-from-string
            (mcp-server-lib-ert-call-tool
             "org-node-set-deadline"
             `((link
                .
                ,(org-records-mcp-test--file-link test-file "*Simple Task"))
               (before . "")
               (after . "2028-02-29"))))))
