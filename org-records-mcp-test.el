        (append (alist-get 'children node) nil)
        `(((title . "Grandchild")
           (level . 3)
           (link
            . ,(org-records-mcp-test--file-link
                test-file "*Grandchild")))))))))

(ert-deftest org-records-mcp-test-node-shape-closed ()
  "A closed node reports its closing timestamp and both tag sets."
