(ert-deftest org-records-mcp-test-file-set-setting-counts-the-other-todo-keywords ()
  "`#+SEQ_TODO:' and `#+TYP_TODO:' name keywords the check counts.
Org reads all three settings into one workflow, so a keyword either
of them names survives a rewrite of `#+TODO:' that does not name it,
and the heading carrying it stays a WAIT heading.  The third file
names WAIT nowhere, so Org reads it as the first word of a title and
the check does not count it: what is counted is the keywords Org
reads, never the words that look like one."
  (dolist (content
           (list
            org-records-mcp-test--content-settings-seq-todo
            org-records-mcp-test--content-settings-typ-todo))
    (org-records-mcp-test--with-temp-org-files ((test-file content))
      (let ((link (concat "file:" (abbreviate-file-name test-file))))
        (should
         (equal
          (alist-get
           'success
           (json-read-from-string
            (mcp-server-lib-ert-call-tool
             "org-file-set-setting"
             `((link . ,link)
               (setting . "TODO")
               (before . ["TODO | DONE"])
               (after . ["TODO NEXT | DONE"])))))
          t))
        (should
         (equal (org-records-mcp-test--settings-todo-of test-file "*hear back")
                "WAIT")))))
  (org-records-mcp-test--with-temp-org-files
      ((test-file org-records-mcp-test--content-settings-one-sequence-only))
    (let ((link (concat "file:" (abbreviate-file-name test-file))))
      (should
       (equal
        (alist-get
         'success
         (json-read-from-string
          (mcp-server-lib-ert-call-tool
           "org-file-set-setting"
           `((link . ,link)
             (setting . "TODO")
             (before . ["TODO | DONE"])
             (after . ["TODO NEXT | DONE"])))))
        t))
      (should
       (null (org-records-mcp-test--settings-todo-of test-file "*WAIT hear back"))))))

