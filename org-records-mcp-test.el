(defun org-records-mcp-test--planning-move (result field)
  "Return what RESULT reports about planning FIELD, or nil for nothing.
FIELD is `scheduled' or `deadline'.  A report is (BEFORE . AFTER):
the state the field was in and the state it is in now, both as a
`before' asserts them, so \"\" is a field holding nothing.  Nothing
reported means the field is as the client last read it."
  (when-let* ((move (alist-get field result)))
    (cons (alist-get 'before move) (alist-get 'after move))))

(defun org-records-mcp-test--finish-repeating (link &rest planning)
  "Ask DONE of the repeating headline LINK, asserting the dates it holds.
PLANNING is the `before_planning' map as name-and-timestamp pairs: a
field the headline carries is named, and one it does not is left out,
which is how the map asserts that it holds nothing.  A repeating
headline is the case the assertion is required in, so its tests name
what it holds."
  (org-records-mcp-test--call-update-todo-state
   link "DONE" "TODO" nil nil
   (mapcar
    (lambda (pair) (cons (car pair) (cadr pair)))
    (seq-partition planning 2))))

(defun org-records-mcp-test--repeat-today-plus (days)
  "Return the Org date text for DAYS from today.
Org writes a date as `org-timestamp-formats' does, so the day name is
the one the running locale gives it and this builds it the same way.

The day is counted on the calendar rather than in hours, because Org
counts it that way: adding 24 hours across a clock change lands on a
different day than adding one day, and `org-records-mcp-test--midday' is what
keeps the two agreeing."
  (format-time-string
   (car org-timestamp-formats)
   (encode-time
    (org-records-mcp-test--midday
     (decoded-time-add
      (decode-time) (make-decoded-time :day days))))))

(ert-deftest org-records-mcp-test-update-todo-state-triggers-repeat ()
  "Test that marking DONE on a task with a repeater triggers the repeat.
The response reports the state Org left the entry in, the not-done
keyword the repeat reset it to, not the done keyword asked for, and
the SCHEDULED it carried on with it."
  (org-records-mcp-test--with-temp-org-files
      ((test-file org-records-mcp-test--content-task-scheduled-repeat))
    (let ((org-log-repeat nil)
          (org-todo-keywords '((sequence "TODO" "|" "DONE"))))
      (let* ((link (org-records-mcp-test--file-link test-file "*Weekly Task"))
             (result
              (org-records-mcp-test--finish-repeating
               link 'scheduled "<2026-01-01 Thu +1w>")))
        ;; Response fields
        (should (equal (alist-get 'success result) t))
        (should (equal (alist-get 'before result) "TODO"))
        (should (equal (alist-get 'after result) "TODO"))
        (should
         (equal (car (org-records-mcp-test--planning-move result 'scheduled))
                "<2026-01-01 Thu +1w>"))
        (should
         (string-match-p
          "\\`<2026-01-08 [^>]*\\+1w>\\'"
          (cdr (org-records-mcp-test--planning-move result 'scheduled))))
        (should-not (org-records-mcp-test--planning-move result 'deadline))
        ;; File: repeat fired — state reverted to TODO, SCHEDULED advanced
        (org-records-mcp-test--verify-file-matches
         test-file
         org-records-mcp-test--expected-weekly-task-repeat-triggered-regex)))))

(ert-deftest org-records-mcp-test-update-todo-state-repeat-to-state ()
  "Test that REPEAT_TO_STATE is respected when repeat triggers.
The response reports the keyword `REPEAT_TO_STATE' named, which is
the state Org left the entry in, and the SCHEDULED that moved with it."
  (org-records-mcp-test--with-temp-org-files
