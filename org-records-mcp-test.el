             (kill-buffer buf)))

         (org-records-mcp-test--with-id-tracking
          (list test-file)
          `((,first-id . ,test-file))
          (let ((parent-link
                 (org-records-mcp-test--file-link test-file "*Parent Task"))
                (after-link (concat "id:" first-id)))
            (org-records-mcp-test--add-todo-and-check
             "New Task After First"
             "TODO"
             '("work")
             nil
             parent-link
             after-link
             (file-name-nondirectory test-file)
             test-file
             org-records-mcp-test--regex-todo-after-sibling))))))))

