            (org-records-mcp-test--call-tool-refused
             "org-node-set-properties"
             `((link
                . ,(org-records-mcp-test--file-link test-file "*Simple Task"))
               (before . ((FIRST) (SECOND)))
               (after . ((FIRST . "1") (SECOND . "2"))))
             "Property hook failed" test-file)
            (with-current-buffer buffer
              (should
               (string=
                (buffer-string)
                org-records-mcp-test--content-bare-todo-final-newline))
              (should-not (buffer-modified-p))))
        (kill-buffer buffer)))))

(ert-deftest org-records-mcp-test-failed-write-after-hook-save-keeps-user-edits ()
  "Test a failed write does not save a buffer the user changed to undo a hook.
The buffer holds the user's unsaved edit.  A hook saves it once FIRST
is written, and the call fails on SECOND.  The buffer is put back to
