(ert-deftest org-records-mcp-test-clock-out-note-goes-with-a-removed-clock-line ()
  "A note has nothing to mark once Org takes the clock line away.
`org-clock-out-remove-zero-time-clocks' deletes a CLOCK line of no
length and the drawer it empties, and Org records no close for a line
it removed.  A note sent with such a call goes the same way, leaving
the file a close with no note leaves."
  (org-records-mcp-test--with-temp-org-files
      ((test-file org-records-mcp-test--clock-out-zero-time-content))
    (let ((org-log-note-clock-out t)
          (org-log-into-drawer t)
          (org-clock-out-remove-zero-time-clocks t))
      (org-records-mcp-test--with-session-clock test-file
        (let* ((link (org-records-mcp-test--file-link test-file "*Task Two"))
               (result
                (org-records-mcp-test--call-clock-out
                 link "2026-01-01T10:00:00"
                 org-records-mcp-test--clock-out-prose)))
          (should (equal (alist-get 'success result) t))
          (should (eq (alist-get 'saved result) t))
          (should (equal (alist-get 'clocked_out result) t))
          (should (equal (alist-get 'heading result) "Task Two"))
          (should (equal (alist-get 'duration result) "0:00"))
          (should (equal (alist-get 'link result) link)))
        (org-records-mcp-test--should-leave-no-log-prompt)
        (org-records-mcp-test--verify-file-matches
         test-file
         org-records-mcp-test--clock-out-zero-time-expected-regex)))))

(defconst org-records-mcp-test--clock-out-switch-state-logged-regex
