          (should (equal (alist-get 'clocked_out result) t)))
        (org-records-mcp-test--should-leave-no-log-prompt)
        (org-records-mcp-test--verify-file-matches
         test-file org-records-mcp-test--clock-out-note-expected-regex)))))

;;; The note a clock-out carries

;; `org-log-note-clock-out' asks Org to record a clock closing, and Org
