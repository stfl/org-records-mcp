;;; View tool tests

(defmacro org-records-mcp-test--with-configured-server
    (file-specs bindings &rest body)
  "Create temp org files and enable org-records-mcp with BINDINGS in force.
FILE-SPECS are (VAR CONTENT) pairs.  BINDINGS is a list of let-style
bindings for the settings that must be set before `org-records-mcp-enable'."
  (declare (indent 2))
  (let* ((vars (mapcar #'car file-specs))
         (temp-vars (mapcar (lambda (v) (gensym (symbol-name v))) vars))
         (let-bindings (cl-mapcar (lambda (v tv) `(,v ,tv)) vars temp-vars))
         (inits (cl-mapcar
                 (lambda (tv spec)
                   `(setq ,tv (make-temp-file "org-records-mcp-test" nil ".org"
                                              ,(nth 1 spec))))
                 temp-vars file-specs))
         (cleanups (mapcar (lambda (tv)
                             `(when ,tv (delete-file ,tv)))
                           temp-vars)))
    `(let (,@temp-vars)
       (unwind-protect
           (progn
             ,@inits
             (let (,@let-bindings
                   (org-records-mcp-allowed-files (list ,@temp-vars))
                   ,@bindings)
               (org-records-mcp-test--with-enabled
                 ,@body)))
         ,@cleanups))))

(defconst org-records-mcp-test--content-views
  "* TODO [#A] Alpha :work:

* TODO [#B] Beta :private:

* TODO Gamma :#inbox:
:PROPERTIES:
:EFFORT:   1:00
:END:

* TODO Delta :tangling:"
  "Items the org-view tests run over.
Gamma carries a drawer, so one match has a property to answer with
and a view that dropped the drawer fails rather than passing on a
file that had none to lose.")

(defun org-records-mcp-test--view-query-inbox ()
  "Return the query of a test view that takes no parameters."
  '(tags "#inbox"))

(defun org-records-mcp-test--view-query-stuck (filter)
  "Return the query of a test view taking FILTER alone."
  (if filter
      `(and (todo "TODO") ,filter)
    '(todo "TODO")))

(defun org-records-mcp-test--view-query-next (filter range)
  "Return the query of a test view taking FILTER and RANGE.
RANGE picks the band, so a test sees which range reached the query:
`sprint' is the A items, anything else every TODO."
  (let ((band
         (if (eq range 'sprint)
             '(priority "A")
           '(todo "TODO"))))
    (if filter
        `(and ,band ,filter)
      band)))

(defconst org-records-mcp-test--views
  '((inbox :name "Inbox" :query org-records-mcp-test--view-query-inbox)
    (stuck
     :name "Stuck Projects"
     :query org-records-mcp-test--view-query-stuck
     :filter t)
    (next
     :name "Next Actions"
     :query org-records-mcp-test--view-query-next
     :filter t
     :range (sprint all))
    (tangling :name "Tangling" :query (tags "tangling")))
  "The views the org-view tests are configured with.
One view per arity: none, a filter, a filter and a range, and one
carrying a literal query rather than a function.")

(defconst org-records-mcp-test--filters
  '((work . (tags "work")) (private . (tags "private")))
  "The filters the org-view tests are configured with.")

(defmacro org-records-mcp-test--with-views (&rest body)
  "Run BODY over `org-records-mcp-test--content-views' with the test views."
  (declare (indent defun) (debug t))
  `(org-records-mcp-test--with-configured-server
       ((test-file org-records-mcp-test--content-views))
       ((org-records-mcp-views org-records-mcp-test--views)
        (org-records-mcp-filters org-records-mcp-test--filters)
        (org-records-mcp-query-sort-fn nil))
     ,@body))

(defun org-records-mcp-test--view-matches (params)
