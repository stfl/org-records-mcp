       "org-node-create"
       `((title . "Task")
         (todo . "TODO")
         (content . ,(car case))
         (parent . ,(concat "file:" test-file)))
       (concat "\\`content must be a string: " (cdr case) "\\'")
       test-file))))

(ert-deftest org-records-mcp-test-node-create-refuses-a-blank-title ()
