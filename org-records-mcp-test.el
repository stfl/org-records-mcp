       `((link . ,link) (before . "Target") (after . "Target renamed")))
      (org-records-mcp-test--with-dirty-buffer (buffer on-disk) test-file
        (org-records-mcp-test--call-tool-refused
         "org-node-archive"
         `((link . ,link) (before . ,stale))
         "\\`conflict: Subtree mismatch: .*nothing was archived\\'"
         test-file)
        (should (string-match-p
                 "TODO Target renamed"
                 (org-records-mcp-test--served-text test-file)))
        (org-records-mcp-test--assert-content-unmoved buffer test-file on-disk)
        (should-not (file-exists-p archive))))))

(ert-deftest org-records-mcp-test-node-refile-through-a-dirty-source-buffer ()
  "A refile out of a buffer the user is editing leaves that file alone.
The node reaches the other file, which org-records-mcp saves, and leaves the
buffer it came from unsaved with the user's edit still in it."
