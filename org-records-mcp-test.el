             "org-file-set-setting"
             `((link . ,link)
               (setting . "TODO")
               (before . ["TODO WAIT | DONE"])
               (after . [])))))
          t))
        (should
         (equal (org-records-mcp-test--settings-todo-of test-file "*ship it")
                "TODO"))
        (org-records-mcp-test--verify-file-matches
         test-file org-records-mcp-test--pattern-settings-global-keyword)))
    (org-records-mcp-test--with-temp-org-files
        ((test-file org-records-mcp-test--content-settings-beyond-the-global))
      (org-records-mcp-test--call-tool-refused
