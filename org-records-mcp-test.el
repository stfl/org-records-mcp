  "Regex matching the DONE file after adding a TODO under Ärger.")

(ert-deftest org-records-mcp-test-title-link-non-ascii-titles ()
  "A title link reaches headings with non-ASCII titles.
org-node-read, the resource with the link sent raw and in each spelling
of `org-records-mcp-test--resource-uris', which encode the titles as UTF-8 or
leave them raw, org-node-text, org-node-set-todo and
org-node-create's parent all reach the heading.  The same titles in a
percent-encoded outline path are no link and are refused."
  (let ((org-todo-keywords '((sequence "TODO" "|" "DONE"))))
    (org-records-mcp-test--with-temp-org-files
        ((test-file org-records-mcp-test--content-non-ascii-titles))
      (let* ((parent (org-records-mcp-test--file-link test-file "*Ärger"))
             (child (org-records-mcp-test--file-link test-file "*Größe #3"))
             (outline-path
              (format "%s#%s/%s" test-file (url-hexify-string "Ärger")
                      (url-hexify-string "Größe #3")))
             (expected (org-records-mcp-test--call-read child)))
        (should
         (equal
          (alist-get 'title (json-read-from-string expected)) "Größe #3"))
        (dolist (uri
                 (cons (concat "org://" child)
                       (org-records-mcp-test--resource-uris child)))
          (should
           (equal
            (cons uri (org-records-mcp-test--read-resource uri))
            (cons uri expected))))
        (should
         (string-prefix-p
          "Not an Org link: "
          (org-records-mcp-test--call-tool-expecting-error
           test-file "org-node-read" `((link . ,outline-path)))))
        (should
         (string=
          (org-records-mcp-test--call-read-headline child)
          "** TODO Größe #3\nGröße body."))
        (org-records-mcp-test--call-update-todo-state child "DONE" "TODO")
        (org-records-mcp-test--verify-file-matches
         test-file org-records-mcp-test--regex-non-ascii-titles-done)
        (org-records-mcp-test--add-todo-and-check
         "New Task" "TODO" nil nil parent nil
         (file-name-nondirectory test-file)
         test-file
         org-records-mcp-test--regex-non-ascii-titles-added)))))

(ert-deftest org-records-mcp-test-resource-decodes-slash-in-title-once ()
  "A `%2F' in the resource URI is a slash inside the title, decoded once.
The title link to Parent/Child, with its slash sent raw or as `%2F',
reads the heading Parent/Child, not Real Child under Parent.  The
outline path that spelled the title with `%2F' is no link: the
resource decodes it once and refuses it as org-node-read refuses the
decoded path."
  (org-records-mcp-test--with-temp-org-files
      ((test-file org-records-mcp-test--content-slash-not-nested-before))
    (let* ((address (org-records-mcp-test--file-link test-file "*Parent/Child"))
           (outline-path (format "%s#Parent%%2FChild" test-file))
           (expected (org-records-mcp-test--call-read address)))
      (should
       (equal (alist-get 'title (json-read-from-string expected)) "Parent/Child"))
      (should
       (string-match-p "%2F" (concat "org://" (url-hexify-string address))))
      (dolist (uri (list (concat "org://" address)
                         (concat "org://" (url-hexify-string address))))
        (should
         (equal (cons uri (org-records-mcp-test--read-resource uri))
                (cons uri expected))))
      (should
       (equal
        (org-records-mcp-test--resource-error (concat "org://" outline-path))
        (org-records-mcp-test--call-tool-expecting-error
         test-file "org-node-read"
         `((link . ,(format "%s#Parent/Child" test-file)))))))))

(ert-deftest org-records-mcp-test-resource-refuses-as-tools-do ()
  "The resource refuses a link with the message the read tools give.
The links run code or open something, name no local file by its full
path, search by regexp, or name what the call may not reach: a file
outside the allowed files, a missing file, an ID in a file outside
them and an unknown ID.  Others are no links at all: a bare ID, a
bare path, an outline path and a link behind a second org://.  Each
goes to org-node-read and org-node-text,
which refuse it with the same message, and in each spelling of
`org-records-mcp-test--resource-uris' to the resource, which answers with an
invalid-params error carrying that message.  Nothing runs, no file is
opened or changed, and the remote path opens no connection."
  (org-records-mcp-test--with-temp-org-files
      ((test-file org-records-mcp-test--content-links)
       (other-file org-records-mcp-test--content-links))
    (org-records-mcp-test--with-id-tracking
        (list test-file)
        `((,org-records-mcp-test--link-beta-id . ,other-file))
      (let ((canary
             (expand-file-name "org-records-mcp-test-link-canary"
                               (file-name-directory test-file)))
            (org-records-mcp-test--link-canary nil)
            (other-before (org-records-mcp-test--read-file-raw other-file)))
        (unwind-protect
            (org-records-mcp-test--with-remote-probe ops
              (dolist (link
                       (list
                        (format "shell:touch %s" canary)
                        (format "[[shell:touch %s][Gamma]]" canary)
                        "elisp:(setq org-records-mcp-test--link-canary t)"
                        "https://example.com/notes.org"
                        "help:org-link-open"
                        (format "file+sys:%s::*Gamma" test-file)
                        (format "file:%s::*Gamma" (file-name-nondirectory test-file))
                        "[[#alpha-slug]]"
                        "*Gamma"
                        (format "file:%s::*Task" (car (org-records-mcp-test--remote-spellings)))
                        (format "file:%s::/Gam.*/" test-file)
                        (format "file:%s::*Gamma" other-file)
                        (format "file:%s.missing.org::*Gamma" test-file)
                        (format "id:%s" org-records-mcp-test--link-beta-id)
                        "id:no-such-id"
                        org-records-mcp-test--link-beta-id
                        test-file
                        (format "%s#Alpha/Review" test-file)
                        "org://id:no-such-id"))
                (let ((message
                       (org-records-mcp-test--call-tool-expecting-error
                        test-file "org-node-read" `((link . ,link)))))
                  (should
                   (equal
                    (org-records-mcp-test--call-tool-expecting-error
                     test-file "org-node-text" `((link . ,link)))
                    message))
                  (dolist (uri (org-records-mcp-test--resource-uris link))
                    (should
                     (equal
                      (cons uri (org-records-mcp-test--resource-error uri))
                      (cons uri message))))))
              (should (null ops)))
          (when (file-exists-p canary)
            (delete-file canary)))
        (should-not org-records-mcp-test--link-canary)
        (should-not (file-exists-p canary))
        (should-not (find-buffer-visiting other-file))
        (should
         (string= (org-records-mcp-test--read-file-raw other-file) other-before))))))

