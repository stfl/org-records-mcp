     (mcp-server-lib-process-jsonrpc-parsed
      (mcp-server-lib-create-tools-call-request tool 1 params)
      mcp-server-lib-ert-server-id))
    :type 'mcp-server-lib-tool-error)))

(ert-deftest org-records-mcp-test-returned-link-forms ()
  "Reads and writes link a heading by its ID, else custom ID, else title.
A heading with both an ID and a custom ID is linked by the ID, an empty
ID counts as none, and a title link leaves out the TODO keyword, the
priority, the statistics cookie and the tags, as Org does.  The title
the node reports leaves out the same, so the title a read returns is
the search a later call sends.  The form does not follow the link the
call was sent: every write here is addressed by a title link.
org-node-read's `id' field is the ID its `link' names."
  (org-records-mcp-test--with-id-setup test-file org-records-mcp-test--content-link-kinds
      (list org-records-mcp-test--link-beta-id org-records-mcp-test--link-both-id)
    (let ((expected
           `(("Alpha" . ,(org-records-mcp-test--file-link test-file "#alpha-slug"))
             ("Beta" . ,(concat "id:" org-records-mcp-test--link-beta-id))
             ("Gamma" . ,(org-records-mcp-test--file-link test-file "*Gamma"))
             ("Both" . ,(concat "id:" org-records-mcp-test--link-both-id))
             ("Blank ID" . ,(org-records-mcp-test--file-link test-file "*Blank ID"))
             ("Decorated"
              . ,(org-records-mcp-test--file-link test-file "*Decorated")))))
      (should
       (equal
        (mapcar
         (lambda (child)
           (cons (alist-get 'title child) (alist-get 'link child)))
         (alist-get
          'children
          (json-read-from-string
           (org-records-mcp-test--call-read (format "file:%s" test-file)))))
        expected))
      (pcase-dolist (`(,title . ,link) expected)
        (let* ((search
                (org-records-mcp-test--file-link test-file (concat "*" title)))
               (heading
                (json-read-from-string (org-records-mcp-test--call-read search))))
          (should (equal (alist-get 'link heading) link))
          (should
           (equal (alist-get 'id heading)
                  (and (string-prefix-p "id:" link) (substring link 3))))
          (should
           (equal (alist-get 'link (org-records-mcp-test--set-seen search)) link)))))))

(ert-deftest org-records-mcp-test-returned-link-off-heading ()
  "Before the first heading, the link searches for the line's text.
An empty line gives the link to the bare file.  No tool returns a link
for a position off a heading, since every tool links a heading, so
the link builder is called directly."
  (org-records-mcp-test--with-temp-org-files
      ((test-file org-records-mcp-test--content-link-kinds))
    (let ((buffer (find-file-noselect test-file)))
      (unwind-protect
          (with-current-buffer buffer
            (goto-char (point-min))
            (forward-line 2)
            (should
             (equal
              (org-records-mcp--link-at-point)
              (org-records-mcp-test--file-link
               test-file "Notes before the first heading.")))
            (forward-line -1)
            (let ((here (point)))
              (should
               (equal
                (org-records-mcp--link-at-point)
                (concat "file:" (abbreviate-file-name test-file))))
              (should (= (point) here)))
            (should-not (buffer-modified-p)))
        (kill-buffer buffer)))))

