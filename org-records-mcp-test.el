        (append (alist-get 'children node) nil)
        `(((title . "Parent")
           (todo . "TODO")
           (level . 1)
           (link . ,(concat "id:" org-records-mcp-test--node-shape-parent-id)))
          ((title . "Second")
           (level . 1)
