(defun org-records-mcp-test--id-locations ()
  "Return the entries of `org-id-locations' as an alist of files and IDs."
  (and (hash-table-p org-id-locations)
       (org-id-hash-to-alist org-id-locations)))

(defmacro org-records-mcp-test--without-id-index (&rest body)
  "Run BODY and assert that it never used Org's ID index.
While BODY runs, `org-id-find', `org-id-find-id-file' and
`org-id-update-id-locations', which consult or rescan the index,
record each call and fail loudly; no call may be recorded.
`org-id-locations' and `org-id-files' must hold the same entries
afterwards as before."
  (declare (indent 0) (debug t))
  (let ((calls (make-symbol "calls"))
        (before (make-symbol "before"))
        (files-before (make-symbol "files-before")))
    `(let ((,calls nil)
           (,before (org-records-mcp-test--id-locations))
           (,files-before (copy-sequence org-id-files)))
       (cl-letf ,(mapcar
                  (lambda (fn)
                    `((symbol-function ',fn)
                      (lambda (&rest _)
                        (push ',fn ,calls)
                        (error "%s ran" ',fn))))
                  '(org-id-find
                    org-id-find-id-file org-id-update-id-locations))
         ,@body)
       (should (null ,calls))
       (should (equal (org-records-mcp-test--id-locations) ,before))
       (should (equal org-id-files ,files-before)))))

(defun org-records-mcp-test--assert-id-task-permitted (file files)
  "Assert that Task in FILE is read and then made DONE by its `id:' link.
FILE holds `org-records-mcp-test--scope-task-with-id-content'.  FILES, when
non-nil, is sent as the `files' parameter, and the calls must then
leave Org's ID index alone."
  (let ((read-and-write
         (lambda ()
           (should
            (string=
             (org-records-mcp-test--call-read-headline
              org-records-mcp-test--scope-id-link files)
             (string-trim-right org-records-mcp-test--scope-task-with-id-content)))
           (should
            (equal
             (alist-get
              'after
              (org-records-mcp-test--call-update-todo-state
               org-records-mcp-test--scope-id-link "DONE" "TODO" nil files))
             "DONE")))))
    (if files
        (org-records-mcp-test--without-id-index
          (funcall read-and-write))
      (funcall read-and-write))
    (org-records-mcp-test--verify-file-matches
     file org-records-mcp-test--scope-task-with-id-done-regex)))

(defun org-records-mcp-test--assert-id-task-refused (file files refusal)
  "Assert that reading and writing Task in FILE by its `id:' link is refused.
FILE holds `org-records-mcp-test--scope-task-with-id-content' and stays
unchanged.  FILES, when non-nil, is sent as the `files' parameter.
Each refusal must match the regexp REFUSAL."
  (let ((params
         `((link . ,org-records-mcp-test--scope-id-link)
           ,@(when files `((files . ,files))))))
    (org-records-mcp-test--call-tool-refused "org-node-text" params refusal)
    (org-records-mcp-test--call-tool-refused
     "org-node-set-todo"
     (append params '((before . "TODO") (after . "DONE")))
     refusal file)))

(ert-deftest org-records-mcp-test-file-set-id-in-allowed-file ()
  "An ID in an allowed file resolves whether or not the call names its file.
This holds for a read and a write under every override setting.  The
file lies outside every root, so only being allowed makes it
reachable."
  (dolist (kind '(nil roots t))
    (dolist (named '(nil t))
      (org-records-mcp-test--with-scope-dirs (if (eq kind 'roots)
                                         (list root)
                                       kind)
        (let ((file (org-records-mcp-test--write-file
                     outside "task.org"
                     org-records-mcp-test--scope-task-with-id-content)))
          (org-records-mcp-test--with-id-tracking
              (list file)
              `((,org-records-mcp-test--content-with-id-id . ,file))
            (org-records-mcp-test--assert-id-task-permitted
             file (and named (vector file)))))))))

(ert-deftest org-records-mcp-test-file-set-id-outside-allowed-files ()
  "An ID outside the allowed files resolves wherever the override reaches it.
The ID is in Emacs's index.  Whether the call names its file in
`files' or leaves the index to name it, the ID is refused under nil
and for a file outside every root, and resolves for a file under a
root and under t: the file the index names is checked as a file the
call names.  A refusal without `files' names the link, never the
file; one with `files' names the file as the call sent it.  The
org://{link} resource, which takes no `files', follows the index the
same way."
  (pcase-dolist (`(,kind ,under-root ,permitted)
                 '((nil t nil) (roots t t) (roots nil nil) (t nil t)))
    (dolist (named '(nil t))
      (org-records-mcp-test--with-scope-dirs (if (eq kind 'roots)
                                         (list root)
                                       kind)
        (let ((file (org-records-mcp-test--write-file
                     (if under-root
                         root
                       outside)
                     "task.org" org-records-mcp-test--scope-task-with-id-content))
              (uri (concat "org://" org-records-mcp-test--scope-id-link)))
          (org-records-mcp-test--with-id-tracking
              (list allowed)
              `((,org-records-mcp-test--content-with-id-id . ,file))
            (cond
             ((and permitted (not named))
              (let ((node
                     (json-read-from-string
                      (org-records-mcp-test--read-resource uri))))
                (should (equal (alist-get 'title node) "Task"))
                (should
                 (equal (alist-get 'link node)
                        org-records-mcp-test--scope-id-link)))
              (org-records-mcp-test--assert-id-task-permitted file nil))
             (permitted
              (org-records-mcp-test--assert-id-task-permitted file (vector file)))
             ((not named)
              (org-records-mcp-test--assert-id-task-refused
               file nil
               (org-records-mcp-test--refused-path-regexp
                org-records-mcp-test--scope-id-link))
              (should
               (string-match-p
                (org-records-mcp-test--refused-path-regexp
                 org-records-mcp-test--scope-id-link)
                (org-records-mcp-test--resource-error uri))))
             (t
              (org-records-mcp-test--assert-id-task-refused
               file (vector file)
               (org-records-mcp-test--refused-path-regexp file))))))))))

(ert-deftest org-records-mcp-test-file-set-id-in-unindexed-file ()
  "An ID in a file Emacs never indexed resolves once the call names its file.
The index holds no entry for the ID, before or after.  The file is
named directly or through its directory, which t lets the call
search, and it is an allowed file or lies outside the allowed files."
  (dolist (via-directory '(nil t))
    (dolist (in-allowed '(nil t))
      (org-records-mcp-test--with-scope-dirs t
        (let ((file (org-records-mcp-test--write-file
                     outside "task.org"
                     org-records-mcp-test--scope-task-with-id-content)))
          (org-records-mcp-test--with-id-tracking
              (list
               (if in-allowed
                   file
                 allowed))
              nil
            (org-records-mcp-test--assert-id-task-permitted
             file
             (vector
              (if via-directory
                  outside
                file)))
            (should-not
             (org-records-mcp-test--id-registered-p
              org-records-mcp-test--content-with-id-id))))))))

(ert-deftest org-records-mcp-test-file-set-id-first-match-in-order ()
  "An ID held by several named files resolves in the first of them.
The order is that of `files', not that of the allowed files."
