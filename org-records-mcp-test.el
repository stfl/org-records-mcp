            (org-records-mcp-test--without-id-index
              (mcp-server-lib-ert-call-tool
               "org-node-create"
               `((title . "New Task")
                 (todo . "TODO")
                 (content . nil)
                 (parent . ,(format "file:%s::*Parent" a-file))
                 (previous_sibling . ,(format after a-file))
