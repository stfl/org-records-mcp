(ert-deftest org-records-mcp-test-tool-read-file-prefers-modified-buffer ()
  "org-node-text serves a file from the buffer the user is editing.
What comes back is the whole buffer: the file's own text and the
user's unsaved edit, which the file on disk does not carry."
  (org-records-mcp-test--with-temp-org-files
      ((test-file org-records-mcp-test--dirty-read-content))
    (org-records-mcp-test--with-dirty-buffer (_buffer on-disk) test-file
      (should
       (string=
        (org-records-mcp-test--served-text test-file)
        (org-records-mcp-test--content-with-user-edit on-disk)))
      (should-not
       (string-match-p
        "Typed by hand"
        (org-records-mcp-test--read-file test-file))))))

(ert-deftest org-records-mcp-test-tool-read-node-prefers-modified-buffer ()
  "org-node-read serves a node from the buffer the user is editing.
The structured read walks the same buffer the verbatim one does, so
the node's body carries the user's unsaved edit and the two agree on
what the file holds."
  (org-records-mcp-test--with-temp-org-files
      ((test-file org-records-mcp-test--dirty-read-content))
    (org-records-mcp-test--with-dirty-buffer (_buffer _on-disk) test-file
      ;; A node's content comes back without the line break that
      ;; separates it from what follows it, so the user's edit is its
      ;; last line rather than a line and a break.
      (should
       (string=
        (org-records-mcp-test--read-content test-file "Task One")
        (concat
         "Original body\n"
         (string-trim-right org-records-mcp-test--user-edit))))
      (should
       (string-match-p
        "Typed by hand"
        (org-records-mcp-test--call-read-headline
         (org-records-mcp-test--file-link test-file "*Task One")))))))

;; Tests for body extraction across various metadata layouts.  These
