(defconst org-records-mcp-test--scope-task-with-id-done-regex
  (concat
   "\\`\\* DONE Task\n"
   ":PROPERTIES:\n"
   ":ID:       " (regexp-quote org-records-mcp-test--content-with-id-id) "\n"
   ":END:\n"
   "Body\n"
   "\\'")
  "Regex matching the whole ID scope-test file after Task becomes DONE.")

