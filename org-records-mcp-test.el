(defun org-records-mcp-test--advertised-lists-configured (lists)
  "Assert every field list the refusal names under LISTS answers as LISTS says."
  (let ((org-records-mcp-node-field-lists lists))
    (org-records-mcp-test--with-temp-org-files
        ((test-file org-records-mcp-test--content-advertised-fields))
      (let* ((link (org-records-mcp-test--file-link test-file "*Rich Task"))
             (message
              (org-records-mcp-test--refusal-message
