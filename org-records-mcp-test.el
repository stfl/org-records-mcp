(ert-deftest org-records-mcp-test-clock-out-failed-after-save-hook ()
  "Test a save failing after the file holds the close says the close was made.
A buffer-local `after-save-hook' fails once the file holds the closed
CLOCK line.  The close stays in buffer and file, the buffer reads
unmodified, and the error says the change was made, so a client does
not close the clock a second time."
  (org-records-mcp-test--with-temp-org-files
      ((test-file org-records-mcp-test--clock-task-with-open-clock))
    (let ((buffer (find-file-noselect test-file)))
      (unwind-protect
          (progn
            (with-current-buffer buffer
              (add-hook 'after-save-hook
                        (lambda () (error "Save hook failed"))
                        nil t))
            (org-records-mcp-test--call-tool-refused
             "org-clock-out"
             `((link
                . ,(org-records-mcp-test--file-link test-file "*Task One"))
               (end_time . "2026-01-01T11:00:00"))
             "\\`The change was made and saved, but .*Save hook failed")
            (org-records-mcp-test--verify-file-matches
             test-file org-records-mcp-test--clock-out-expected-regex)
            (org-records-mcp-test--verify-buffer-matches
             buffer org-records-mcp-test--clock-out-expected-regex)
            (org-records-mcp-test--verify-no-modified-buffer test-file)
            (with-current-buffer buffer
              (kill-local-variable 'after-save-hook)))
        (kill-buffer buffer)))))

